<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-biorepository-qc-round-plan" author="openelis-biorepository">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="biorepository_qc_round_plan" schemaName="clinlims"/>
            </not>
        </preConditions>

        <createTable tableName="biorepository_qc_round_plan" schemaName="clinlims">
            <column name="qc_batch_id" type="VARCHAR(80)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="samples_json" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="last_updated" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
