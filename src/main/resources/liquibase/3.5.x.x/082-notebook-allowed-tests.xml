<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="082-notebook-allowed-tests-table" author="ahri-order-filter">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="notebook_allowed_tests" schemaName="clinlims"/>
            </not>
        </preConditions>
        <comment>
            Per-template list of allowed test IDs for Stage 1 order creation.
            When a notebook template has entries in this table, the Patient &amp; Lab Order
            page only shows those tests in the test-selection list.
            An empty list means "show all tests" (backward-compatible default).
        </comment>
        <createTable tableName="notebook_allowed_tests" schemaName="clinlims">
            <column name="notebook_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="test_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey
            tableName="notebook_allowed_tests"
            schemaName="clinlims"
            columnNames="notebook_id, test_id"
            constraintName="pk_notebook_allowed_tests"/>
        <addForeignKeyConstraint
            baseTableName="notebook_allowed_tests"
            baseTableSchemaName="clinlims"
            baseColumnNames="notebook_id"
            referencedTableName="notebook"
            referencedTableSchemaName="clinlims"
            referencedColumnNames="id"
            constraintName="fk_notebook_allowed_tests_notebook"
            onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
