<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="083-notebook-participants-table" author="ahri-participants">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="notebook_participants" schemaName="clinlims"/>
            </not>
        </preConditions>
        <comment>
            Per-notebook list of participant system user IDs.
            Multiple users can participate in a project in addition to the assigned technician.
        </comment>
        <createTable tableName="notebook_participants" schemaName="clinlims">
            <column name="notebook_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="system_user_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey
            tableName="notebook_participants"
            schemaName="clinlims"
            columnNames="notebook_id, system_user_id"
            constraintName="pk_notebook_participants"/>
        <addForeignKeyConstraint
            baseTableName="notebook_participants"
            baseTableSchemaName="clinlims"
            baseColumnNames="notebook_id"
            referencedTableName="notebook"
            referencedTableSchemaName="clinlims"
            referencedColumnNames="id"
            constraintName="fk_notebook_participants_notebook"
            onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
